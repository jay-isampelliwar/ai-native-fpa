# Copy to .env and fill in. Every setting and its default is in app/core/config.py.

# Required
OPENAI_API_KEY=sk-replace-me
JWT_SECRET=change-me-to-a-long-random-string
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/fpa
REDIS_URL=redis://localhost:6380/0

# Session cookie. Set COOKIE_SECURE=true behind HTTPS.
TOKEN_TTL_MINUTES=10080
COOKIE_SECURE=false

# Optional: web search. Without a key the web_search tool says it is unavailable.
TAVILY_API_KEY=

# Optional: tracing. It is on only when both keys are set.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Used only by Docker Compose to start the local Postgres container.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fpa
